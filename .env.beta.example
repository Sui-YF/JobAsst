APP_MODE=beta
APP_DEBUG=false
BETA_BASE_URL=http://YOUR_SERVER_IP:8501/
STREAMLIT_SERVER_PORT=8501

LLM_PROVIDER=qwen
QWEN_API_KEY=YOUR_SERVER_SIDE_QWEN_API_KEY
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_RESPONSE_FORMAT=json_object

DAILY_LLM_REQUEST_LIMIT=50
MAX_LLM_RETRIES=1
LLM_TIMEOUT_SECONDS=90
MAX_UPLOAD_MB=10

ENABLE_OCR=false
ENABLE_WEB_TEMPLATE_SEARCH=false
ENABLE_JD_URL_FETCH=false
JD_FETCH_TIMEOUT_SECONDS=8
JD_FETCH_MAX_BYTES=2000000
